{
  "_meta": {
    "description": "House News topic manifest. Replaces the old RSS firehose model. Each topic defines the trends we actually care about, the search queries that hunt for them, and the primary sources that own that territory.",
    "workflow": "For each topic: run search_queries through web_search -> cross-reference primary_sources for full reads -> pick 1-3 stories worth a full article -> draft into drafts/ -> promote to articles/ -> update articles.json -> link from index.html",
    "lenses": {
      "intelligence": "Core technical shifts in the AI substrate - models, agents, research breakthroughs",
      "tools": "Immediate tool updates, workflow optimizations, creative software releases",
      "infrastructure": "Semiconductors, compute, data centers, power, supply chain, geopolitics"
    }
  },
